; ---- Sound bytes ----
; Four bytes with no reader in v2.33 (leftover Osc2 aliases and a Wave1 source
; alias) that the flash pack stores: modes take 6 bits, amounts 7.
SOUND_WARP1_MODE    equ  $15
SOUND_WARP1_AMOUNT  equ  $14
SOUND_WARP2_MODE    equ  $20
SOUND_WARP2_AMOUNT  equ  $17

; The modes a Sound holds, Serum's set in Serum's order.
WARP_MODE_OFF       equ  0
WARP_MODE_BEND_PLUS equ  1
WARP_MODE_BEND_MINUS equ  2
WARP_MODE_BEND_PLUS_MINUS equ  3
WARP_MODE_PWM       equ  4
WARP_MODE_ASYM_PLUS equ  5
WARP_MODE_ASYM_MINUS equ  6
WARP_MODE_ASYM_PLUS_MINUS equ  7
WARP_MODE_MIRROR    equ  8
WARP_MODE_QUANTIZE  equ  9
WARP_MODE_LAST      equ  WARP_MODE_QUANTIZE
WARP_MODE_NAME_CHARS  equ  9

WARP_DSP_OFF        equ  0
WARP_DSP_BEND       equ  1
WARP_DSP_PWM        equ  2
WARP_DSP_ASYM       equ  3
WARP_DSP_MIRROR     equ  4
WARP_DSP_QUANTIZE   equ  5

; ---- Frame ----
; p30..p33 Osc1, p34..p37 Osc2: routine address, then three parameters.
WARP_AMOUNT_CENTER     equ  64
WARP_BEND_K_BASE       equ  320
WARP_BEND_K_BASE_SIDED equ  635
WARP_BEND_K_SHIFT      equ  19
WARP_PWM_AMOUNT_MAX    equ  119
WARP_PWM_WIDTH_ONE     equ  128
WARP_PWM_NUMERATOR     equ  $4000000
WARP_HALF_TURN         equ  $400000
WARP_ASYM_KNEE_STEP    equ  $cccc
WARP_ASYM_KNEE_STEP_SIDED equ $6735
WARP_ASYM_NUMERATOR    equ  $20000000
WARP_ASYM_KNEE_SHIFT   equ  12
WARP_TURN              equ  $800000
WARP_MIRROR_KNEE_MIN   equ  3
WARP_MIRROR_KNEE_MAX   equ  29
WARP_MIRROR_KNEE_SPAN  equ  WARP_MIRROR_KNEE_MAX-WARP_MIRROR_KNEE_MIN
WARP_MIRROR_KNEE_SHIFT equ  17
WORD_MASK              equ  $ffff
WARP_QUANTIZE_FEWEST   equ  2
WARP_QUANTIZE_POWER_STEPS equ 3
WARP_QUANTIZE_SCALE    equ  499
WARP_QUANTIZE_FEWEST_FRACTION equ WARP_QUANTIZE_FEWEST<<18
WARP_QUANTIZE_DIVISOR_SHIFT equ 10
WARP_QUANTIZE_NUMERATOR equ $80000000

; ---- Modulation ----
; Two matrix destinations past v2.33's 36 add to the warp amounts.
MOD_DEST_W1_WARP     equ  36
MOD_DEST_W2_WARP     equ  37
MOD_DEST_LAST        equ  MOD_DEST_W2_WARP
MOD_DEST_ORDER_COUNT equ  MOD_DEST_LAST+1
MOD_DEST_NAME_CHARS  equ  9
WARP_MOD_VOICE_BYTES equ  8
WARP_MOD_VOICE_SHIFT equ  3
WARP_AMOUNT_MAX      equ  127
WARP_MOD_RAM         equ  MORPH_RAM+MORPH_RAM_BYTES
WARP_MOD_RAM_BYTES   equ  VOICE_EXPANDED_COUNT*WARP_MOD_VOICE_BYTES
MOD_DEST_ORDER_INVERSE_RAM equ  WARP_MOD_RAM+WARP_MOD_RAM_BYTES
EDITION_RAM_USED_END equ  MOD_DEST_ORDER_INVERSE_RAM+MOD_DEST_ORDER_COUNT

; ---- MIDI ----
WARP1_MODE_CC       equ  49
WARP1_AMOUNT_CC     equ  59
WARP2_MODE_CC       equ  63
WARP2_AMOUNT_CC     equ  119
